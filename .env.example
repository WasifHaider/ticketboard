# All variables are optional — sane defaults are baked into
# ticketboard/config.py. TICKETBOARD reads these straight from the
# process environment; no .env loader is bundled, so if you want to use
# this file, load it yourself (e.g. `export $(cat .env | xargs)` on
# macOS/Linux, or python-dotenv if you add it to requirements.txt).

# SQLite database file path. Defaults to <repo>/ticketboard.db.
# TICKETBOARD_DB_PATH=./ticketboard.db

# uvicorn bind address. Use 127.0.0.1 to restrict to localhost-only,
# 0.0.0.0 to allow LAN access (e.g. from your phone) — see the Security
# note in README.md before doing this on an untrusted network.
# TICKETBOARD_HOST=0.0.0.0
# TICKETBOARD_PORT=8000

# Max agentic turns / wall-clock timeout for a single ticket build.
# TICKETBOARD_CLAUDE_MAX_TURNS=40
# TICKETBOARD_CLAUDE_TIMEOUT_S=1800

# A ticket stuck in_progress longer than this many hours gets flagged in
# the daily digest as a likely stuck/crashed worker.
# TICKETBOARD_STALE_HOURS=3

# Acceptance-criteria judge pass: a second, fresh Claude Code invocation
# that checks the diff against your acceptance criteria after tests pass.
# Set to 0 to disable and rely on tests alone.
# TICKETBOARD_JUDGE_ENABLED=1
# TICKETBOARD_JUDGE_MAX_TURNS=10
# TICKETBOARD_JUDGE_TIMEOUT_S=300
# TICKETBOARD_JUDGE_MAX_DIFF_CHARS=20000
